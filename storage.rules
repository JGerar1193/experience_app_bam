rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes de productos: cualquiera las ve; solo admins las suben o reemplazan.
    match /products/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }
  }
}