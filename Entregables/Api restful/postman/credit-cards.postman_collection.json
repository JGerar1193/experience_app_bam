{
  "info": {
    "name": "API Financiera - Tarjetas de credito",
    "description": "Pruebas de los cinco endpoints requeridos. Ejecuta POST antes de PATCH y DELETE para guardar cardId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "cardId", "value": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa" }
  ],
  "item": [
    {
      "name": "GET - Listar tarjetas activas",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-cards" }
    },
    {
      "name": "POST - Crear tarjeta",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('cardId', pm.response.json().id);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"creditLimit\": 8500.75\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/credit-cards"
      }
    },
    {
      "name": "GET - Consultar tarjeta por ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/credit-cards/{{cardId}}" }
    },
    {
      "name": "PATCH - Actualizar limite y estado",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"creditLimit\": 10000,\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/credit-cards/{{cardId}}"
      }
    },
    {
      "name": "DELETE - Eliminacion logica",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/credit-cards/{{cardId}}" }
    }
  ]
}
