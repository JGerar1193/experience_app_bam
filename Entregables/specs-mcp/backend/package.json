{
  "name": "internal-wallet-transfers",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": "26.13.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "lint": "oxlint src test scripts jest.config.cjs",
    "start": "node dist/main.js",
    "start:mcp:demo": "node dist/mcp/main.js --demo",
    "start:dev": "node --watch dist/main.js",
    "test:compile": "node scripts/compile-tests.cjs",
    "pretest:unit": "npm run test:compile",
    "test:unit": "node --experimental-vm-modules --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit",
    "pretest:integration": "npm run test:compile",
    "test:integration": "node --experimental-vm-modules --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects integration",
    "pretest:e2e": "npm run test:compile",
    "test:e2e": "node --experimental-vm-modules --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "oxlint": "1.90.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3"
  }
}
